                  "pageId": 1048060,
                  "revisionId": 2786380,
                  "section": "Notes",
                  "excerpt": "The augment does not work on any enemy which can't be lifted by Sandstorm ."
                }
              },
              {
                "reviewStatus": "draft",
                "provenance": {
                  "source": "local-wiki-sqlite",
                  "pageTitle": "Elemental Sandstorm",
                  "pageId": 1048060,
                  "revisionId": 2786380,
                  "section": "Notes",
                  "excerpt": "When triggered, Sandstorm will pick one of the damage types and inflict 1 status proc of the chosen type for every 100% Status Chance ."
                }
              },
