                "reviewStatus": "draft",
                "provenance": {
                  "source": "local-wiki-sqlite",
                  "pageTitle": "Hunter Munitions",
                  "pageId": 1235676,
                  "revisionId": 2722408,
                  "section": "Notes",
                  "excerpt": "Pure elemental weapons such as Synapse can trigger Slash procs using this mod."
                }
