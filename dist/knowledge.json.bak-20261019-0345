                "reviewStatus": "draft",
                "provenance": {
                  "source": "local-wiki-sqlite",
                  "pageTitle": "Hunter Synergy",
                  "pageId": 1235678,
                  "revisionId": 2738023,
                  "section": "Notes",
                  "excerpt": "This bonus stacks after other mods have been applied."
