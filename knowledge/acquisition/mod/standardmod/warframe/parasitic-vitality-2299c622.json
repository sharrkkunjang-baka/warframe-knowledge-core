          ],
          "mechanicsEvidence": {
            "status": "draft",
            "notes": [
              {
                "reviewStatus": "draft",
                "provenance": {
                  "source": "local-wiki-sqlite",
                  "pageTitle": "Parasitic Vitality",
                  "pageId": 1583856,
                  "revisionId": 2794933,
                  "section": "Notes",
                  "excerpt": "Bonus Health scales with Mutations stacks, up to 200x at full mutation for +800% Health , and scales with Ability Strength ."
                }
              },
              {
                "reviewStatus": "draft",
                "provenance": {
                  "source": "local-wiki-sqlite",
                  "pageTitle": "Parasitic Vitality",
                  "pageId": 1583856,
                  "revisionId": 2794933,
                  "section": "Notes",
                  "excerpt": "This can be further increased by utilizing Abundant Mutation which increases Mutation stacks up to 500 . This increases unmodded health by up to +2000% ."
                }
              },
              {
                "reviewStatus": "draft",
                "provenance": {
                  "source": "local-wiki-sqlite",
                  "pageTitle": "Parasitic Vitality",
                  "pageId": 1583856,
                  "revisionId": 2794933,
                  "section": "Notes",
                  "excerpt": "Bonus is additive to other sources of percentage health increases such as Vigor and Gladiator Resolve ."
                }
              },
              {
                "reviewStatus": "draft",
                "provenance": {
                  "source": "local-wiki-sqlite",
                  "pageTitle": "Parasitic Vitality",
                  "pageId": 1583856,
                  "revisionId": 2794933,
                  "section": "Notes",
                  "excerpt": "Bonus scales off of base Health , i.e. before any mods or other health bonuses such as Arcane Blessing or Azure Archon Shard 's health bonus."
                }
              },
              {
                "reviewStatus": "draft",
                "provenance": {
                  "source": "local-wiki-sqlite",
                  "pageTitle": "Parasitic Vitality",
                  "pageId": 1583856,
                  "revisionId": 2794933,
                  "section": "Notes",
                  "excerpt": "The number of Mutation stacks needed to be on par with a maxed Vitality at base Ability Strength is 25 . Increasing Ability Strength will lower this floor ."
                }
              },
              {
                "reviewStatus": "draft",
                "provenance": {
                  "source": "local-wiki-sqlite",
                  "pageTitle": "Parasitic Vitality",
                  "pageId": 1583856,
                  "revisionId": 2794933,
                  "section": "Notes",
                  "excerpt": "Counts as a Vitality mod, thus cannot be used in conjunction with Vitality , Archon Vitality , or Umbral Vitality ."
                }
              },
              {
                "reviewStatus": "draft",
                "provenance": {
                  "source": "local-wiki-sqlite",
                  "pageTitle": "Parasitic Vitality",
                  "pageId": 1583856,
                  "revisionId": 2794933,
                  "section": "Notes",
                  "excerpt": "The ally linked however, will gain the bonus regardless of his mods ."
                }
              },
              {
                "reviewStatus": "draft",
                "provenance": {
                  "source": "local-wiki-sqlite",
                  "pageTitle": "Parasitic Vitality",
                  "pageId": 1583856,
                  "revisionId": 2794933,
                  "section": "Notes",
                  "excerpt": "Nidus will still gain the bonus health even if linked to an enemy."
                }
              },
              {
                "reviewStatus": "draft",
                "provenance": {
                  "source": "local-wiki-sqlite",
                  "pageTitle": "Parasitic Vitality",
                  "pageId": 1583856,
                  "revisionId": 2794933,
                  "section": "Notes",
                  "excerpt": "When the link breaks, there is a 5 second countdown before Parasitic Vitality's health bonus disappears until Nidus links with a new target."
                }
              },
              {
                "reviewStatus": "draft",
                "provenance": {
                  "source": "local-wiki-sqlite",
                  "pageTitle": "Parasitic Vitality",
                  "pageId": 1583856,
                  "revisionId": 2794933,
                  "section": "Notes",
                  "excerpt": "When Nidus gains a mutation stack, his maximum will be updated to reflect the new value and he heals in the process, often enough for a full heal whenever gaining a stack."
                }
              },
              {
                "reviewStatus": "draft",
                "provenance": {
                  "source": "local-wiki-sqlite",
                  "pageTitle": "Parasitic Vitality",
                  "pageId": 1583856,
                  "revisionId": 2794933,
                  "section": "Notes",
                  "excerpt": "The healing gained is modified by current health, max health modifiers other than Parasitic Vitality, new stack count, and strength. With a fully ranked augment, gaining a stack heals:"
                }
              },
              {
                "reviewStatus": "draft",
                "provenance": {
                  "source": "local-wiki-sqlite",
                  "pageTitle": "Parasitic Vitality",
                  "pageId": 1583856,
                  "revisionId": 2794933,
                  "section": "Notes",
                  "excerpt": "Healing received = Current Health × 4% × (1 + Ability Strength) × Mutation Stack Count × (Base Health ÷ Max Health without augment) ."
                }
              },
              {
                "reviewStatus": "draft",
                "provenance": {
                  "source": "local-wiki-sqlite",
                  "pageTitle": "Parasitic Vitality",
                  "pageId": 1583856,
                  "revisionId": 2794933,
                  "section": "Notes",
                  "excerpt": "This means that modifiers which increase max health, such as Vigor , Arcane Blessing , or Elemental Ward reduce the healing effect (Possible bug)."
                }
              }
            ],
